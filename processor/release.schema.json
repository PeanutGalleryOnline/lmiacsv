{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmia.peanutgallery.online/schemas/release-v0.1.json",
  "title": "LMIA source release",
  "type": "object",
  "required": [
    "id",
    "filename",
    "sha256",
    "bytes",
    "status",
    "language",
    "row_count",
    "columns",
    "publication_ready"
  ],
  "properties": {
    "id": { "type": "string" },
    "filename": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": { "type": "integer", "minimum": 0 },
    "year": { "type": ["integer", "null"], "minimum": 2000, "maximum": 2100 },
    "quarter": {
      "type": ["string", "null"],
      "enum": ["Q1", "Q2", "Q3", "Q4", "Q1-Q2", "Q3-Q4", null]
    },
    "status": { "type": ["string", "null"], "enum": ["positive", "negative", null] },
    "language": { "type": "string", "enum": ["en", "fr", "unknown"] },
    "row_count": { "type": "integer", "minimum": 0 },
    "columns": { "type": "array", "items": { "type": "string" } },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "has_xlsx_pair": { "type": "boolean" },
    "publication_ready": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

