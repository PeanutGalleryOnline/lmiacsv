---
interface Props {
	title?: string;
	status?: string;
	body?: string;
}

const {
	title = 'Foundation build',
	status = 'Experimental',
	body = 'The legacy files have been inventoried, but they are not yet a publication-ready dataset. Source URLs, duplicate releases, and historical schema changes remain explicit work—not hidden assumptions.',
} = Astro.props;
---

<aside class="foundation-notice" aria-label="Publication status">
	<span class="status-chip">{status}</span>
	<div>
		<strong>{title}</strong>
		<p>{body}</p>
	</div>
</aside>

<style>
.foundation-notice {
	display: grid;
	grid-template-columns: auto 1fr;
	gap: 1rem;
	align-items: start;
	margin: 2rem 0;
	padding: 1.1rem 1.2rem;
	border: 1px solid var(--sl-color-gray-5);
	border-left: 4px solid var(--sl-color-accent);
	border-radius: 0.35rem;
	background: var(--sl-color-gray-7);
}

.status-chip {
	display: inline-flex;
	padding: 0.25rem 0.5rem;
	border-radius: 999px;
	background: var(--sl-color-accent-low);
	color: var(--sl-color-accent-high);
	font-size: 0.62rem;
	font-weight: 800;
	letter-spacing: 0.09em;
	text-transform: uppercase;
}

.foundation-notice strong {
	font-family: 'Fraunces Variable', 'Fraunces', serif;
	color: var(--sl-color-gray-1);
}

.foundation-notice p {
	margin: 0.25rem 0 0;
	font-size: 0.88rem;
	line-height: 1.55;
	color: var(--sl-color-gray-3);
}

@media (max-width: 34rem) {
	.foundation-notice { grid-template-columns: 1fr; }
}
</style>
