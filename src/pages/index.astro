---
import overview from '../../data/published/overview.json';
import '../styles/theme.css';
import BaseLayout from 'peanutbutter/src/components/BaseLayout.astro';
import Masthead from 'peanutbutter/src/components/Masthead.astro';
import Footer from 'peanutbutter/src/components/Footer.astro';
import PGLink from 'peanutbutter/src/components/PGLink.astro';
import SearchHero from 'peanutbutter/src/components/SearchHero.astro';
import FoundationNotice from '../components/FoundationNotice.astro';

const inventory = overview.inventory;
const coverage = overview.coverage;
const fmt = new Intl.NumberFormat('en-CA');
const positiveFiles = inventory.files_by_status.positive ?? 0;
const negativeFiles = inventory.files_by_status.negative ?? 0;
---

<BaseLayout
	title="The LMIA Record — Peanut Gallery"
	description="Canada's published LMIA decision lists, being rebuilt as a searchable and sourced public record."
>
	<Masthead
		slot="header"
		icons="🥜📋"
		location="Canada"
		locationIcon="emojione-monotone:maple-leaf"
		label="Public Data"
		est="12,026 HE"
		title="The LMIA Record"
		sub="Canada's published LMIA decisions — searchable, sourced &amp; legible"
		homeHref="https://peanutgallery.online"
	/>

	<main class="record-layout">
		<section class="lede">
			<p>Canada publishes lists of employers that received positive and negative Labour Market Impact Assessment decisions. The record is public, but scattered across years of inconsistent spreadsheets.</p>
			<p>This publication is being built to let anyone follow that record by employer, occupation, place, period, and original government release—without pretending the source data is cleaner than it is.</p>
		</section>

		<FoundationNotice
			status="Pilot ready"
			title="The first verified release is live locally"
			body="The 2025 Q1 slice now runs from official workbook checksums to row-level canonical records and visible aggregates. The wider legacy archive remains an inventory until each release passes the same gate."
		/>

		<SearchHero
			action="/quarter/2025-q1/"
			title="Search verified Q1 employer records"
			placeholder="Try an employer name…"
		/>

		<section class="inventory" aria-labelledby="inventory-heading">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Legacy source inventory</p>
					<h2 id="inventory-heading">What we can account for today</h2>
				</div>
				<PGLink type="page" href="/releases/" label="Browse release catalogue">Browse releases</PGLink>
			</div>

			<div class="metrics">
				<div class="metric">
					<strong class="num">{inventory.csv_files}</strong>
					<span>CSV source files</span>
				</div>
				<div class="metric">
					<strong class="num">{fmt.format(inventory.raw_rows)}</strong>
					<span>raw rows inventoried</span>
				</div>
				<div class="metric">
					<strong>{coverage.start_year}–{coverage.end_year}</strong>
					<span>detected coverage</span>
				</div>
				<div class="metric split">
					<strong><i class="positive"></i>{positiveFiles} / <i class="negative"></i>{negativeFiles}</strong>
					<span>positive / negative files</span>
				</div>
			</div>
			<p class="metric-caveat">Raw source rows include unresolved duplicates and historical files outside the intended 2016–2025 product window. They are an inventory measure, not a count of applications, decisions, workers, or people.</p>
		</section>

		<section class="questions" aria-labelledby="questions-heading">
			<p class="eyebrow">Product direction</p>
			<h2 id="questions-heading">One record, several ways in</h2>
			<div class="question-grid">
				<article>
					<span class="question-icon">🏢</span>
					<h3>Employers</h3>
					<p>See published name variants, occupations, locations, positions and underlying releases without silently merging different organizations.</p>
				</article>
				<article>
					<span class="question-icon">🧰</span>
					<h3>Occupations</h3>
					<p>Follow demand across provinces and periods while keeping NOC 2011 and NOC 2021 classifications distinct.</p>
				</article>
				<article>
					<span class="question-icon">🗺️</span>
					<h3>Places</h3>
					<p>Explore province and postal-region patterns with the limits and missingness of the source data visible.</p>
				</article>
				<article>
					<span class="question-icon">🗃️</span>
					<h3>Releases</h3>
					<p>Trace every published number back to a specific file, sheet, row, checksum and authoritative government URL.</p>
				</article>
			</div>
		</section>

		<section class="next">
			<div>
				<p class="eyebrow">Verified pilot</p>
				<h2>Explore the 2025 Q1 vertical slice</h2>
				<p>Search 17,029 normalized employer-name keys, compare positive and negative decision measures without inventing an approval rate, and trace the release back to two official government workbooks.</p>
			</div>
			<PGLink type="page" href="/quarter/2025-q1/" label="Explore the verified 2025 Q1 pilot">Explore Q1 2025</PGLink>
		</section>
	</main>

	<Footer slot="footer" navCols={[
		{ heading: 'Explore', links: [
			{ label: '2025 Q1 pilot', href: '/quarter/2025-q1/' },
			{ label: 'Source releases', href: '/releases/' },
			{ label: 'Methodology', href: '/methodology/' },
		]},
		{ heading: 'Peanut Gallery', links: [
			{ label: 'All publications', href: 'https://peanutgallery.online' },
		]},
	]} />
</BaseLayout>

<style>
.lede {
	padding-top: 2.5rem;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 2rem;
	font-size: 1.05rem;
	line-height: 1.7;
	color: var(--sl-color-gray-2);
}

.lede p { margin: 0; }
.lede p:first-child { font-size: 1.2rem; color: var(--sl-color-gray-1); }

.inventory, .questions, .next {
	margin-top: 3.5rem;
	padding-top: 2rem;
	border-top: 1px solid var(--sl-color-gray-5);
}

.section-heading, .next {
	display: flex;
	justify-content: space-between;
	align-items: end;
	gap: 2rem;
}

h2 {
	font-family: 'Fraunces Variable', 'Fraunces', serif;
	font-size: clamp(1.65rem, 4vw, 2.35rem);
	color: var(--sl-color-gray-1);
	margin: 0.25rem 0 0;
	border: none;
}

.metrics {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	margin-top: 1.5rem;
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 0.5rem;
	overflow: hidden;
}

.metric {
	padding: 1.25rem;
	background: var(--sl-color-gray-7);
	border-right: 1px solid var(--sl-color-gray-5);
}
.metric:last-child { border-right: none; }
.metric strong {
	display: block;
	font-family: 'Fraunces Variable', 'Fraunces', serif;
	font-size: 1.7rem;
	color: var(--sl-color-gray-1);
}
.metric span {
	display: block;
	margin-top: 0.2rem;
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--sl-color-gray-3);
}
.metric i {
	display: inline-block;
	width: 0.6rem;
	height: 0.6rem;
	border-radius: 50%;
	margin-right: 0.35rem;
}
.metric i.positive { background: var(--record-positive); }
.metric i.negative { background: var(--record-negative); margin-left: 0.25rem; }

.metric-caveat {
	margin: 0.75rem 0 0;
	font-size: 0.78rem;
	line-height: 1.5;
	color: var(--sl-color-gray-4);
}

.question-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1rem;
	margin-top: 1.5rem;
}
.question-grid article {
	padding: 1.35rem;
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 0.5rem;
	background: var(--sl-color-gray-7);
}
.question-icon { font-size: 1.45rem; }
.question-grid h3 {
	font-family: 'Fraunces Variable', 'Fraunces', serif;
	font-size: 1.25rem;
	margin: 0.55rem 0 0.35rem;
	color: var(--sl-color-gray-1);
}
.question-grid p, .next p {
	margin: 0;
	font-size: 0.9rem;
	line-height: 1.6;
	color: var(--sl-color-gray-3);
}
.next { margin-bottom: 3rem; }
.next > div { max-width: 46rem; }
.next h2 { margin-bottom: 0.6rem; }

@media (max-width: 48rem) {
	.lede, .question-grid { grid-template-columns: 1fr; gap: 1rem; }
	.metrics { grid-template-columns: 1fr 1fr; }
	.metric:nth-child(2) { border-right: none; }
	.metric:nth-child(-n+2) { border-bottom: 1px solid var(--sl-color-gray-5); }
	.section-heading, .next { align-items: flex-start; flex-direction: column; }
}

@media (max-width: 30rem) {
	.metrics { grid-template-columns: 1fr; }
	.metric { border-right: none; border-bottom: 1px solid var(--sl-color-gray-5); }
	.metric:last-child { border-bottom: none; }
}
</style>
