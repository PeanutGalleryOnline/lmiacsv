  "limitations": [
    {
      "code": "personal-names-excluded",
      "text": "The source lists exclude personal names, including some caregiver employers and business names containing personal names, so they are not complete employer lists."
    },
    {
      "code": "employer-names-manually-entered",
      "text": "Employer names are manually entered in the source system and may contain data-entry errors or inconsistent spelling."
    },
    {
      "code": "positions-not-workers",
      "text": "Position counts describe positions on LMIA decisions, not work permits issued or temporary foreign workers who entered Canada."
    },
    {
      "code": "positive-positions-may-not-be-filled",
      "text": "A position on a positive LMIA may not lead to a work permit and may later be cancelled by the employer."
    },
    {
      "code": "negative-reasons-not-row-level",
      "text": "The negative list does not publish a decision reason for each employer record."
    },
